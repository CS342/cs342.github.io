---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import PageHeader from '../components/PageHeader.astro';
import AppPanel from '../components/AppPanel.astro';
import InfoSections from '../components/InfoSections.astro';
import { applications, courseCode, offering, pages } from '../lib/content';
import { url } from '../lib/paths';

const app = applications.student;
const contact = app.contact;
---
<Base title="Apply as a Student" description={`Who should apply to ${courseCode}: ${offering.title}, what to expect, and how the ${offering.term} student application works.`}>
  <PageHeader tone="green" eyebrow={`Students · ${offering.term}`} title="Apply as a Student" lead={pages.apply.lead}>
    <AppPanel slot="side" app={app} tone="green" />
  </PageHeader>

  <InfoSections sections={pages.apply.sections} />

  <Band id="apply" label="Apply">
    <div class="stack">
      <h2>{app.action}</h2>
      <AppPanel app={app} tone="green" boxed />
      <p>
        Questions about the course or the application? Contact {contact.name}{contact.role ? `, ${contact.role}` : ''}, at
        <a class="link" href={`mailto:${contact.email}`}>{contact.email}</a>.
      </p>
      <p class="actions">
        <a class="more" href={url('/syllabus/')}>Read the syllabus <span class="arrow" aria-hidden="true">→</span></a>
        <a class="more" href={url('/sessions/')}>See the schedule <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </Band>
</Base>
