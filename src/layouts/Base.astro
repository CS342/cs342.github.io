---
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, offering, courseName, clock } from '../lib/content';
import { url } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = offering.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${courseName}` : `${courseName} — ${offering.term}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const clockJson = JSON.stringify(clock).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || site.launchStatus === 'review') && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={courseName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {site.launchStatus === 'review' && <p class="banner banner--review">{site.reviewNotice}</p>}
    <p class="banner banner--preview" id="preview-banner" role="status" hidden></p>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script type="application/json" id="course-clock" set:html={clockJson} />
    <script>
      import '../scripts/live.ts';
    </script>
  </body>
</html>
