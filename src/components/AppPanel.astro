---
// Full application panel: status headline, dates, and the form button — shown only
// when the route is open and has a published form link. An open route also renders
// its closed state so the browser can switch to it once the deadline passes.
import type { Application } from '../lib/content';
import { effectiveApplicationStatus, type ApplicationStatus } from '../lib/state';
import { applicationView } from '../lib/appview';

interface Props {
  app: Application;
  tone: string;
  boxed?: boolean;
}
const { app, tone, boxed = false } = Astro.props;
const status = effectiveApplicationStatus({ status: app.status, formUrl: app.formUrl, closes: app.closesUtc?.getTime() }, Date.now());
const switchable = app.status === 'open' && !!app.formUrl && !!app.closesUtc;
const variants: ApplicationStatus[] = switchable ? ['open', 'closed'] : [status];
---
<div class:list={['panel', `tone-${tone}`, boxed && 'panel--boxed']} data-app-closes={switchable ? app.closesUtc!.toISOString() : undefined}>
  {variants.map((variant) => {
    const view = applicationView(app, variant);
    return (
      <div class="panel__variant" data-app-variant={switchable ? variant : undefined} hidden={switchable && variant !== status}>
        <div class="panel__head">
          <p class="label">{app.name}</p>
          <p class="panel__status">{view.headline}</p>
        </div>
        <div class="panel__body">
          {variant === 'open' && (
            <dl class="panel__facts">
              <div>
                <dt class="label">Deadline</dt>
                <dd>{app.closesLabel ?? 'To be announced'}</dd>
              </div>
            </dl>
          )}
          {variant === 'open' && (
            <a class="btn" href={app.formUrl} target="_blank" rel="noopener">
              {app.action} <span class="arrow" aria-hidden="true">↗</span>
            </a>
          )}
          {variant === 'open' && <p class="small">Opens Google Forms in a new tab.{app.signInNote ? ` ${app.signInNote}` : ''}</p>}
          {variant === 'opening-soon' && <p>The form will be linked here when it opens.</p>}
          {variant === 'closed' ? <p>{app.closedMessage}</p> : <p>{app.process}</p>}
          <p class="small">
            Questions: <a class="link" href={`mailto:${app.contact.email}`}>{app.contact.email}</a>
          </p>
        </div>
      </div>
    );
  })}
</div>

<style>
  .panel__variant {
    display: contents;
  }
  .panel--boxed {
    height: auto;
    max-width: 32rem;
    border: 1px solid var(--ink);
  }
</style>
